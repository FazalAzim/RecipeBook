rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public Cover Images: publicly readable, writable by admins/creators
    match /book-covers/{bookId}/{fileName} {
      allow read: if true;
      allow write: if true;
    }

    // Recipe Book PDFs: downloadable by purchasers, writable by admins/creators
    match /book-pdfs/{bookId}/{fileName} {
      allow read: if true;
      allow write: if true;
    }
  }
}
