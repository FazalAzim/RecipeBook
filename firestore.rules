rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    
    // Must check exists() before get(). A missing users/{uid} doc (brand-new signup)
    // would otherwise fail the entire rule with "Missing or insufficient permissions".
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(userDocPath()) && get(userDocPath()).data.role == 'admin')
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Books Collection
    match /books/{bookId} {
      allow read: if (resource.data.isPublished == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Orders Collection (Supports both authenticated users & guest purchases)
    match /orders/{orderId} {
      allow read: if true; // Allows customer receipt retrieval by order ID
      allow create: if true; // Allows guest and authenticated checkout order placement
      allow update, delete: if isAdmin();
    }

    // Libraries Collection (Purchased Books)
    match /libraries/{libraryId} {
      allow read: if true; // Allows verified purchasers to access their downloads
      allow create: if true; // Created upon successful order placement
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'lastDownloadedAt']);
      allow delete: if isAdmin();
    }
  }
}
