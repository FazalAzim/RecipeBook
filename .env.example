# =============================================================================
# RecipeBooks Market — Environment Template
# =============================================================================
# HOW TO USE
# ----------
# 1) LOCAL development:
#      cp .env.example .env.local
#      Fill in the values below in .env.local
#      Run: npm run dev
#
# 2) VERCEL (production):
#      Do NOT commit .env.local
#      In Vercel → Project → Settings → Environment Variables
#      Add the same keys listed here (Production + Preview)
#      Set NEXT_PUBLIC_APP_URL to your live site URL
#
# 3) Lemon Squeezy test vs live (local):
#      Set LEMON_SQUEEZY_MODE=test  OR  LEMON_SQUEEZY_MODE=live
#      Put both keys below; only the active mode is used
# =============================================================================

# --- App ---
# Local:  http://localhost:3000
# Vercel: https://your-app.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MongoDB ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=recipebooks

# --- Cloudflare R2 ---
CLOUDFLARE_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=recipe-bucket
# Optional public CDN. Leave empty to serve covers via /api/media
CLOUDFLARE_R2_PUBLIC_URL=

# --- Lemon Squeezy ---
# Mode: "test" (sandbox cards) or "live" (real payments)
LEMON_SQUEEZY_MODE=live

# Used when LEMON_SQUEEZY_MODE=live (or as fallback if mode-specific keys are empty)
LEMON_SQUEEZY_API_KEY=

# Optional: keep both keys so you can flip MODE without re-pasting
LEMON_SQUEEZY_API_KEY_LIVE=
LEMON_SQUEEZY_API_KEY_TEST=

# Store is usually the same; variants differ between test and live
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_VARIANT_ID_LIVE=
LEMON_SQUEEZY_VARIANT_ID_TEST=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# --- Auth ---
# Generate a long random string for production (32+ chars)
AUTH_SECRET=
