# MongoDB Connection URI (Atlas example)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/recipebooks?retryWrites=true&w=majority
MONGODB_URI=

# Cloudflare R2 S3-compatible Storage
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=recipe-bucket
# Optional: custom public domain for R2 (e.g. https://cdn.yourdomain.com)
# Leave empty to serve covers through /api/media signed URLs (private bucket).
CLOUDFLARE_R2_PUBLIC_URL=

# Stripe Payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Authentication Secret (Used for JWT cookie encryption)
AUTH_SECRET=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
